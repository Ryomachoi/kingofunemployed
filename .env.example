# ==== Supabase 기본 설정 ====
# 프로젝트 URL과 키는 Supabase 대시보드(Project Settings → API)에서 확인하세요.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 서비스 롤 키는 서버 전용입니다. 절대 저장소에 커밋하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY


# ==== 사이트 기본 URL ====
# 로컬 개발 시 http://localhost:3000 을 사용합니다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ==== Naver OAuth ====
# 네이버 개발자 센터에서 애플리케이션을 등록하고 아래 값을 설정하세요.
# Callback URL(리다이렉트 URI): http://localhost:3000/api/auth/naver/callback
# 참고: 현재 코드가 NEXT_PUBLIC_* 접두사를 사용합니다. 비공개가 더 안전하므로 운영 환경에선 비공개 키로의 전환을 권장합니다.
NEXT_PUBLIC_NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NEXT_PUBLIC_NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET


# ==== OpenAI ====
# 면접 분석(AI 피드백) 기능에 필요합니다.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Responses API에서 사용하는 프롬프트 ID 및 버전
# 프롬프트 ID는 OpenAI 콘솔에서 생성한 Prompt의 ID입니다.
OPENAI_PROMPT_ID=YOUR_OPENAI_PROMPT_ID
# 기본값은 8이며 필요 시 수정하세요.
OPENAI_PROMPT_VERSION=8


# ==== Node/Next 환경 ====
# 로컬 개발에서는 development를 사용합니다.
NODE_ENV=development